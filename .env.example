# ── Solami ────────────────────────────────────────────────────────────────
# One key is enough if its role has gRPC, DataApi (Blur) and RPC access.
# Get one at https://solami.dev/signup (Pro trial covers everything here).
SOLAMI_API_KEY=
# Optional: separate keys per product if your permissions are split.
# SOLAMI_GRPC_KEY=
# SOLAMI_DATA_KEY=
# SOLAMI_RPC_KEY=
# Pin a region (nyc | fra | ams). Empty = nearest.
SOLAMI_REGION=

# ── Server ────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1

# ── Radar & tripwires ─────────────────────────────────────────────────────
RADAR=true
# Automatically arm tripwires on launches that show traction.
AUTO_WATCH=true
AUTO_WATCH_MIN_PROGRESS=15
AUTO_WATCH_MIN_BUYERS=15
AUTO_WATCH_MAX=40
# Enrich watched tokens with Blur intel (needs DataApi on the key).
BLUR_ENRICH=true

# ── Exits ─────────────────────────────────────────────────────────────────
# paper: quote (and simulate when a wallet is set), never send.
# live:  sign and land through Beam. Use a burner wallet.
EXIT_MODE=paper
# Base58 secret key or JSON byte array. Only needed for live exits / simulation.
WALLET_SECRET_KEY=
# Refuse any single exit worth more than this many SOL.
EXIT_MAX_SOL=0.5
EXIT_SLIPPAGE_BPS=1500
# Beam tip (min 100000 lamports = 0.0001 SOL) and priority fee.
BEAM_TIP_LAMPORTS=100000
PRIORITY_FEE_MICROLAMPORTS=200000

# ── Notifications (optional) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
